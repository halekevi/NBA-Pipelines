# Copy to a local file outside git (e.g. `.env` or `private/.env`) — never commit real values.
#
# SECRET_KEY=change-me-long-random
# PROPORACLE_SECRET_KEY=change-me-long-random
# Required to create accounts on the public site (login still works without new sign-ups).
# PROPORACLE_SIGNUP_CODE=pick-a-private-phrase
# Optional dedicated accounts SQLite (default: sibling of PROPORACLE_DB_PATH, else persistent data dir).
# PROPORACLE_ACCOUNTS_DB=/data/proporacle_accounts.db
# DATABASE_URL=postgresql://user:pass@host:5432/proporacle
# PROPORACLE_DB_PATH=C:/path/to/proporacle_income.db
# Income dashboard: auto-seeds demo bets when bet_result is empty; set 0 to disable.
# PROPORACLE_INCOME_SEED_DEMO=0
# PP_COOKIE=
# ODDS_API_KEY=
# GOOGLE_API_KEY=
